diff --git a/lib/depth.js b/lib/depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..0a8fe750e315b6a2f6be3c5891a3f3cda55df402
--- /dev/null
+++ b/lib/depth.js
@@ -0,0 +1,9 @@
+'use strict';
+
+// Bound every recursive AST path, including callers supplying an AST directly.
+const MAX_DEPTH = 128;
+module.exports = depth => {
+  if (depth > MAX_DEPTH) {
+    throw new SyntaxError(`Brace nesting exceeds maximum depth (${MAX_DEPTH})`);
+  }
+};
