# -----------------------------------------------------------------------------
# Supabase Auth + Database (povinné)
# Project Settings > API: https://supabase.com/dashboard/project/_/settings/api
# NEXT_PUBLIC_ hodnoty jsou veřejné; nikdy sem nedávejte service role/secret key.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://liczsygjiuaobdzytyea.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Veřejná URL aplikace a logo v e-mailech (APP_BASE_URL je povinné v produkci)
# Pokud REMINDER_LOGO_URL zůstane prázdné, použije se
# ${APP_BASE_URL}/brand/drevohlavica.png.
# -----------------------------------------------------------------------------
APP_BASE_URL=https://www.splatno.cz
REMINDER_LOGO_URL=

# -----------------------------------------------------------------------------
# Resend – odesílání upomínek a webhook doručení (povinné pro e-maily)
# REMINDER_EMAIL_FROM musí být adresa na doméně ověřené v Resendu.
# -----------------------------------------------------------------------------
RESEND_API_KEY=
REMINDER_EMAIL_FROM=upominky@splatno.cz
RESEND_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Vercel Cron – tajný náhodný řetězec alespoň 16 znaků (povinné pro automatizaci)
# Chrání endpoint /api/cron/check-due.
# -----------------------------------------------------------------------------
CRON_SECRET=

# -----------------------------------------------------------------------------
# OpenAI OCR – vytěžení PDF/obrázků faktur (volitelné)
# Bez OPENAI_API_KEY bude OCR v health checku označeno jako nepřipravené.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_OCR_MODEL=gpt-5.6-sol

# VERCEL_OIDC_TOKEN sem nepřidávejte. Vercel jej spravuje automaticky a lokální
# token z `vercel env pull` je krátkodobý a patří pouze do ignorované .env.local.
