# -----------------------------------------------------------------------------
# Supabase Auth + Database (povinné)
# Project Settings > API: https://supabase.com/dashboard/project/_/settings/api
# NEXT_PUBLIC_ hodnoty jsou veřejné; nikdy sem nedávejte service role/secret key.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://liczsygjiuaobdzytyea.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# -----------------------------------------------------------------------------
# Veřejná URL aplikace (APP_BASE_URL je povinné v produkci). Logo v upomínkách
# je logo firmy z organizations.logo_path (${APP_BASE_URL}<logo_path>);
# firma bez loga posílá upomínky bez loga. REMINDER_LOGO_URL se už nepoužívá.
# -----------------------------------------------------------------------------
APP_BASE_URL=https://www.splatno.cz

# -----------------------------------------------------------------------------
# Resend – odesílání upomínek a webhook doručení (povinné pro e-maily)
# REMINDER_EMAIL_FROM musí být adresa na doméně ověřené v Resendu.
# -----------------------------------------------------------------------------
RESEND_API_KEY=
REMINDER_EMAIL_FROM=Splatno <upominky@mail.splatno.cz>
AUTH_EMAIL_FROM=Splatno <prihlaseni@mail.splatno.cz>
AUTH_EMAIL_DELIVERY_ENABLED=true
RESEND_WEBHOOK_SECRET=
# Pouze pro localhost/development. Je-li vyplněno, odeslání na jiné adresy se zablokuje.
LOCAL_EMAIL_RECIPIENT_ALLOWLIST=test-admin@hlavica.cz

# E-mailové 2FA po přihlášení heslem. SECRET musí být náhodný řetězec alespoň
# 32 znaků. Potvrzený test-admin@hlavica.cz je jediná pevná testovací výjimka.
EMAIL_MFA_SECRET=

# -----------------------------------------------------------------------------
# Vercel Cron – tajný náhodný řetězec alespoň 16 znaků (povinné pro automatizaci)
# Chrání endpoint /api/cron/check-due.
# -----------------------------------------------------------------------------
CRON_SECRET=
GPC_IMPORT_ENABLED=true
# Pro první fázi lze nastavit pouze admin; po ověření změňte na admin,accounting.
GPC_IMPORT_ROLES=admin,accounting

# VERCEL_OIDC_TOKEN sem nepřidávejte. Vercel jej spravuje automaticky a lokální
# token z `vercel env pull` je krátkodobý a patří pouze do ignorované .env.local.

# -----------------------------------------------------------------------------
# Automatické párování plateb z bankovního výpisu
# "shadow" (výchozí) = návrhy se jen připraví a čekají na potvrzení člověkem.
# "automatic" = cron /api/cron/reconcile-payments sám zaúčtuje jen ty řádky,
# které matcher označil jako "safe" (shoda VS/čísla faktury nebo potvrzeného
# účtu odběratele + přesná zbývající částka). Vše ostatní zůstává k revizi.
# -----------------------------------------------------------------------------
PAYMENT_RECONCILIATION_MODE=automatic

# Doplňkové návrhy: stávající v5 automatiku tento režim nemění.
# off = vypnuto, shadow = porovnávání bez úhrad, review = člověkem potvrzované návrhy.
# Každá novinka navíc vyžaduje explicitní seznam UUID firem (oddělený čárkami).
PAYMENT_ASSISTANCE_MODE=off
PAYMENT_ASSISTANCE_ORGANIZATIONS=
PAYMENT_PAYER_MEMORY_ENABLED=false
PAYMENT_REEVALUATION_ENABLED=false
PAYMENT_CAMT_ENABLED=false
# Zapnout až po ověření skutečného anonymizovaného exportu KB, ne syntetických testů.
PAYMENT_CAMT_KB_SAMPLE_VERIFIED=false

# -----------------------------------------------------------------------------
# Rozpoznávání údajů z nahraných faktur (OCR)
# "local" (výchozí) = lokální parser (pdfjs/tesseract + pravidla), nic
# neopouští server.
# "gemini" = KAŽDÝ dokument se ODESÍLÁ externí AI službě (Google Gemini,
# volané přímo přes generativelanguage.googleapis.com, bez OpenRouter).
# "hybrid" = lokální parser běží vždy jako první (zdarma); Gemini se zavolá
# jen když je některé důležité pole ve stavu review/missing. Výsledky obou
# enginů se sloučí pole po poli
# (viz invoice-ocr-reconcile.ts) -- u peněžních polí a IČO se při neshodě
# NIKDY tiše nevybírá vítěz, jen se přidá varování k ruční kontrole.
# Než "gemini"/"hybrid" zapnete na produkci se skutečnými zákaznickými
# fakturami, ověřte podmínky zpracování dat u modelu nastaveného v
# GEMINI_MODEL. GEMINI_API_KEY získáte na https://aistudio.google.com/apikey.
# NEXT_PUBLIC_OCR_PROVIDER musí být nastavené na STEJNOU hodnotu jako
# OCR_PROVIDER -- řídí větu v UI, která uživatele informuje, že dokument
# opouští firmu. Nikdy je nerozjíždějte.
# -----------------------------------------------------------------------------
OCR_PROVIDER=local
NEXT_PUBLIC_OCR_PROVIDER=local
# "shadow" (bezpečný rollout) vyhodnocuje kontextová pravidla a ARES bez
# změny předvyplněné identity; "active" začne nejisté identity blokovat.
OCR_CONTEXTUAL_MODE=active
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Playwright e2e ---
# Bez hesla nemá e2e sada přihlášenou session a všechny workspace testy
# selžou s jasnou hláškou (dřív se tiše přeskakovaly a CI svítilo zeleně,
# přestože reálně běžel jediný test). Používá se test-admin@hlavica.cz,
# protože je to jediný účet obcházející e-mailové MFA -- jinak by se čekalo
# na šestimístný kód z e-mailu, což automatizovat nejde.
E2E_EMAIL=test-admin@hlavica.cz
E2E_PASSWORD=
# Vědomé povolení běhu bez přihlášení. Výchozí je false: chybějící session
# má být chyba, ne ticho.
E2E_ALLOW_UNAUTHENTICATED=false

# Temporary server-only exception for an explicitly entered/saved testing contact.
# OCR still rejects issuer addresses. Remove or set false after testing.
ALLOW_ADAM_REMINDER_TEST_EMAIL=false

# --- Předplatné Splatna (stránka /predplatne) ---
# Údaje Splatna jako dodavatele na výzvách k platbě a fakturách. Bez nich
# se nákup nenabízí. Účet v českém tvaru (předčíslí-číslo/kód banky).
SPLATNO_SUPPLIER_NAME=
SPLATNO_SUPPLIER_ICO=
SPLATNO_SUPPLIER_DIC=
SPLATNO_SUPPLIER_ADDRESS=
SPLATNO_SUPPLIER_ACCOUNT=
SPLATNO_SUPPLIER_EMAIL=
# "true" = plátce DPH (faktura připočte 21 % a je daňovým dokladem).
SPLATNO_SUPPLIER_VAT_PAYER=false
# Platební brána Comgate (karta, Apple/Google Pay, bankovní tlačítka).
# Bez klíčů se nabízí jen převod. COMGATE_TEST=false až pro ostrý provoz.
# V Comgate nastavte URL pro oznámení o platbě: https://splatno.cz/api/billing/comgate
COMGATE_MERCHANT=
COMGATE_SECRET=
COMGATE_TEST=true

# --- Ověření firmy datovou schránkou ---
# Přihlašovací jméno a heslo datové schránky Splatna pro webové služby ISDS.
# Bez nich se ověření předává provozovateli (/provoz). ISDS_ENV=production
# pro ostrý provoz, jinak testovací prostředí czebox.cz.
ISDS_USERNAME=
ISDS_PASSWORD=
ISDS_ENV=test

# --- Provoz Splatna ---
# E-maily provozovatelů (oddělené čárkou) s přístupem na /provoz.
SPLATNO_OPERATOR_EMAILS=
