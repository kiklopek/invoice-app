# Supabase — najdeš v Project Settings > API na supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_DEMO_MODE=false

# Resend — pro odesílání e-mailových upomínek (resend.com)
RESEND_API_KEY=
REMINDER_EMAIL_FROM=upominky@tvojedomena.cz
RESEND_WEBHOOK_SECRET=

# Tajný klíč, kterým Vercel Cron potvrzuje volání /api/cron/check-due
CRON_SECRET=

# OpenAI Responses API — multimodální vytěžení PDF a obrázků faktur
OPENAI_API_KEY=
# Volitelné; bez nastavení se použije aktuální výchozí model.
OPENAI_OCR_MODEL=gpt-5.6-sol

# Klíče nikdy nesmí mít prefix NEXT_PUBLIC_ ani být uložené v repozitáři.
