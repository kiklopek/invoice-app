+               {mobile && canManage && !issuedDocument(invoice) && <button type="button" className={styles.mobileMenuDelete} disabled={updating || deleting} onClick={() => { closeActionsMenu();setDeleteConfirmOpen(true); }}>Smazat fakturu</button>}
+             </div>
