+       setError(
+         cause instanceof Error
+           ? cause.message
+           : "Platbu se nepodařilo uvolnit.",
+       );
+     } finally {
+       setUpdating(false);
+     }
+   }
+   async function deleteInvoice() {
+     setDeleting(true);
+     setError("");
+     setNotice("");
